<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:AzdoQualityMetrics.ViewModels" x:Class="AzdoQualityMetrics.Views.MainWindow" Title="AzdoQualityMetrics" Width="1500" Height="960" MinWidth="1400" MinHeight="900">
 <Grid RowDefinitions="Auto,*" Margin="16">
  <Border Grid.Row="0" Padding="14" CornerRadius="10" Background="#F3F6FC" BorderBrush="#D8E0EE" BorderThickness="1"><Grid ColumnDefinitions="Auto,2*,2*,Auto,Auto,Auto" ColumnSpacing="12"><TextBlock Text="AzdoQualityMetrics" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Organization"/><TextBox Text="{Binding Organization}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Project"/><TextBox Text="{Binding Project}"/></StackPanel><Button Grid.Column="3" Content="Connect" Command="{Binding ConnectCommand}" VerticalAlignment="Bottom"/><TextBlock Grid.Column="4" Text="{Binding ConnectionStatus}" VerticalAlignment="Bottom"/><TextBlock Grid.Column="5" Text="PAT loaded from configuration" VerticalAlignment="Bottom"/></Grid></Border>
  <Grid Grid.Row="1" ColumnDefinitions="310,*" ColumnSpacing="14" Margin="0,14,0,0">
   <ScrollViewer Grid.Column="0"><StackPanel Spacing="10"><TextBlock Text="Filters" FontSize="20" FontWeight="Bold"/><Border BorderBrush="#D8E0EE" BorderThickness="1" CornerRadius="8" Padding="10" Background="#FFFFFF"><StackPanel Spacing="6"><TextBlock Text="Areas" FontSize="14" FontWeight="SemiBold"/><StackPanel><Button Content="Refresh Areas" Command="{Binding RefreshAreasCommand}"/><TreeView ItemsSource="{Binding Areas}" Height="230"><TreeView.ItemTemplate><TreeDataTemplate ItemsSource="{Binding Children}"><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"/></TreeDataTemplate></TreeView.ItemTemplate></TreeView></StackPanel></StackPanel></Border><Border BorderBrush="#D8E0EE" BorderThickness="1" CornerRadius="8" Padding="10" Background="#FFFFFF"><StackPanel Spacing="6"><TextBlock Text="Work Item Types" FontSize="14" FontWeight="SemiBold"/><StackPanel><Button Content="Refresh Types" Command="{Binding RefreshTypesCommand}"/><ItemsControl ItemsSource="{Binding WorkItemTypeOptions}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></StackPanel></Border><Border BorderBrush="#D8E0EE" BorderThickness="1" CornerRadius="8" Padding="10" Background="#FFFFFF"><StackPanel Spacing="6"><TextBlock Text="Completed States" FontSize="14" FontWeight="SemiBold"/><StackPanel><Button Content="Refresh States" Command="{Binding RefreshStatesCommand}"/><ItemsControl ItemsSource="{Binding CompletedStateOptions}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></StackPanel></Border><Border BorderBrush="#D8E0EE" BorderThickness="1" CornerRadius="8" Padding="10" Background="#FFFFFF"><StackPanel Spacing="6"><TextBlock Text="Delivery Qualification Mode" FontSize="14" FontWeight="SemiBold"/><StackPanel><ComboBox ItemsSource="{Binding QualificationModes}" SelectedItem="{Binding QualificationMode}"/></StackPanel></StackPanel></Border><Border BorderBrush="#D8E0EE" BorderThickness="1" CornerRadius="8" Padding="10" Background="#FFFFFF"><StackPanel Spacing="6"><TextBlock Text="Period" FontSize="14" FontWeight="SemiBold"/><StackPanel Spacing="6"><DatePicker SelectedDate="{Binding StartDate}"/><DatePicker SelectedDate="{Binding EndDate}"/><NumericUpDown Value="{Binding PeriodValue}" Minimum="1"/><ComboBox ItemsSource="{Binding PeriodUnits}" SelectedItem="{Binding PeriodUnit}"/></StackPanel></StackPanel></Border><Grid ColumnDefinitions="*,*"><Button Content="GO" Command="{Binding GoCommand}" Background="#1769E0" Foreground="White"/><Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}"/></Grid><TextBlock Text="{Binding Operation}" TextWrapping="Wrap"/><ProgressBar Value="{Binding Progress}" Maximum="100" IsIndeterminate="{Binding IsBusy}"/></StackPanel></ScrollViewer>
   <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="12"><UniformGrid Columns="4" Rows="1"><Border Background="#FFF0F0" CornerRadius="9" Padding="14" Margin="3"><StackPanel><TextBlock Text="Registered Bugs"/><TextBlock Text="{Binding RegisteredBugs}" FontSize="30" FontWeight="Bold"/></StackPanel></Border><Border Background="#EDF5FF" CornerRadius="9" Padding="14" Margin="3"><StackPanel><TextBlock Text="Delivered Effort"/><TextBlock Text="{Binding DeliveredEffort}" FontSize="30" FontWeight="Bold"/></StackPanel></Border><Border Background="#EDFAF2" CornerRadius="9" Padding="14" Margin="3"><StackPanel><TextBlock Text="Delivered Work Items"/><TextBlock Text="{Binding DeliveredWorkItems}" FontSize="30" FontWeight="Bold"/></StackPanel></Border><Border Background="#F5ECFF" CornerRadius="9" Padding="14" Margin="3"><StackPanel><TextBlock Text="Bugs per 100 Effort"/><TextBlock Text="{Binding BugsPer100Effort, StringFormat={}{0:F2}}" FontSize="30" FontWeight="Bold" Foreground="#8438C8"/></StackPanel></Border></UniformGrid><Border Grid.Row="1" Padding="12" Background="#F5F7FB" CornerRadius="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Metadata}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Export KPI Summary CSV" Command="{Binding ExportKpiCommand}"/></Grid></Border><TabControl Grid.Row="2"><TabItem Header="Results"><Grid ColumnDefinitions="*,*" ColumnSpacing="10"><StackPanel><TextBlock Text="Registered Bugs" FontSize="18" FontWeight="Bold"/><TextBox Watermark="Search bugs" Text="{Binding BugSearch}"/><Button Content="Export Bugs CSV" Command="{Binding ExportBugsCommand}" HorizontalAlignment="Right"/><DataGrid ItemsSource="{Binding FilteredBugs}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Id" Binding="{Binding Id}"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Created Date" Binding="{Binding CreatedDate}"/><DataGridTextColumn Header="Area Path" Binding="{Binding AreaPath}"/></DataGrid.Columns></DataGrid></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Delivered Work" FontSize="18" FontWeight="Bold"/><TextBox Watermark="Search delivered work" Text="{Binding DeliveredSearch}"/><Button Content="Export Delivered CSV" Command="{Binding ExportDeliveredCommand}" HorizontalAlignment="Right"/><DataGrid ItemsSource="{Binding FilteredDelivered}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Id" Binding="{Binding Id}"/><DataGridTextColumn Header="Type" Binding="{Binding WorkItemType}"/><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Effort" Binding="{Binding Effort}"/><DataGridTextColumn Header="Done Date" Binding="{Binding DoneDate}"/><DataGridTextColumn Header="Mode" Binding="{Binding QualificationMode}"/></DataGrid.Columns></DataGrid></StackPanel></Grid></TabItem><TabItem Header="Logs"><StackPanel><ComboBox SelectedItem="{Binding LogFilter}" ItemsSource="{Binding LogFilters}"/><Button Content="Open Log Folder" Command="{Binding OpenLogFolderCommand}" HorizontalAlignment="Right"/><DataGrid ItemsSource="{Binding FilteredLogs}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}"/><DataGridTextColumn Header="Level" Binding="{Binding Level}"/><DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="3*"/></DataGrid.Columns></DataGrid></StackPanel></TabItem></TabControl></Grid>
  </Grid>
 </Grid>
</Window>
